# حساب Azure Storage نفسه المستخدم في الموقع
AZURE_STORAGE_ACCOUNT=doctoratelectures
AZURE_STORAGE_KEY=PASTE_YOUR_ACCESS_KEY_HERE

# حاوية المحاضرات الحالية
AZURE_STORAGE_CONTAINER=lectures
AZURE_LIBRARY_CONTAINER=library

# حاوية منفصلة لملفات الاختبارات الكاملة (تُنشأ تلقائيًا كحاوية خاصة)
AZURE_EXAMS_CONTAINER=exams

# Azure Portal > Storage account > Resource sharing (CORS) > Blob service:
# Allowed origins: https://www.docmathdz.dev, https://docmathdz.dev
# Allowed methods: GET, HEAD, PUT, OPTIONS
# Allowed headers: *
# Exposed headers: Accept-Ranges, Content-Length, Content-Range, ETag
# Max age: 3600
