# نفس حساب وحاوية Azure المستخدمين حاليًا في صفحة الدروس والمحاضرات
AZURE_STORAGE_ACCOUNT=doctoratelectures
AZURE_STORAGE_KEY=PASTE_YOUR_EXISTING_ACCESS_KEY_HERE
AZURE_STORAGE_CONTAINER=lectures
AZURE_LIBRARY_CONTAINER=library

# اختياري فقط: اتركه غير موجود لاستعمال حاوية المحاضرات نفسها.
# AZURE_EXAMS_CONTAINER=exams

# ملفات الاختبارات تُحفظ داخل الحاوية الحالية تحت المسار:
# exams/topics/{topicId}/...
# لا يلزم إنشاء حاوية أو إعداد Azure جديد إذا كانت روابط المحاضرات تعمل بالفعل.
