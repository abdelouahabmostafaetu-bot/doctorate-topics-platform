# تخزين ملفات المحاضرات على Azure Blob Storage (رصيد Azure for Students)
# أضف هذه الأسطر إلى ملف .env المحلي وإلى Vercel → Settings → Environment Variables
# لا ترفع ملف .env إلى Git أبدًا.

# اسم حساب التخزين الذي أنشأته في Azure Portal
AZURE_STORAGE_ACCOUNT=doctoratelectures

# المفتاح: Azure Portal → Storage account → Security + networking → Access keys → key1 → Key
AZURE_STORAGE_KEY=PASTE_YOUR_ACCESS_KEY_HERE

# اسم الحاوية العامة (Anonymous access level = Blob)
AZURE_STORAGE_CONTAINER=lectures

# ملاحظات:
# - إن تُركت هذه المتغيّرات فارغة، يعود رفع المحاضرات تلقائيًا إلى Cloudflare R2 (السلوك القديم).
# - ملفات المحاضرات القديمة الموجودة على R2 تبقى تعمل ولا تحتاج أي ترحيل.
# - باقي أقسام الموقع (المواضيع، المكتبة، الصور الشخصية) تبقى على R2 عبر متغيّرات STORAGE_*.
