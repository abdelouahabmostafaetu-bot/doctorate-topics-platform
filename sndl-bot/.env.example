# انسخ هذا الملف باسم .env ثم املأ القيم
# القيمة فقط بعد علامة = — بلا أقواس ولا مسافات

# رمز البوت من BotFather
SNDL_BOT_TOKEN=

# رقمك في تيليجرام من @userinfobot
SNDL_OWNER_ID=

# حساب SNDL
SNDL_USER=
SNDL_PASS=

# اختياري: الحد اليومي للمقالات
SNDL_DAILY_LIMIT=30

# اختياري: بريدك لخدمة Unpaywall
UNPAYWALL_EMAIL=

# اختياري: مسار Chrome إن لم يُعثر عليه تلقائيًا
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# اختياري: ضع 1 لرؤية المتصفح أثناء العمل (للتشخيص)
# SNDL_SHOW_BROWSER=1
