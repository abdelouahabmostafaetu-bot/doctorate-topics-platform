# انسخ هذا الملف باسم .env ثم املأ القيم

# رمز البوت من BotFather
SNDL_BOT_TOKEN=

# رقمك في تيليجرام من @userinfobot
SNDL_OWNER_ID=

# حساب SNDL (للمقالات المدفوعة)
SNDL_USER=
SNDL_PASS=

# اختياري: الحد اليومي
SNDL_DAILY_LIMIT=50

# اختياري: بريدك (يحسّن أداء Crossref و Unpaywall)
UNPAYWALL_EMAIL=

# اختياري: مفتاح CORE المجاني من core.ac.uk
CORE_API_KEY=

# اختياري: ضع 0 لإلغاء حصر النتائج في الرياضيات
MATH_ONLY=1

# اختياري: مسار Chrome إن لم يُعثر عليه
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# اختياري: 1 لرؤية المتصفح أثناء العمل
# SNDL_SHOW_BROWSER=1
