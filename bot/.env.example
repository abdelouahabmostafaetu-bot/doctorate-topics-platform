# رمز البوت من BotFather (انظر README.md)
TELEGRAM_BOT_TOKEN=

# رابط موقعك المنشور على Azure بدون / في النهاية
# مثال: https://<app-name>.azurewebsites.net  أو نطاقك الخاص إن وُجد
PLATFORM_API_BASE=https://<your-app-name>.azurewebsites.net

# مفتاح سري مشترك بين البوت والموقع — ضع نفس القيمة في:
# Azure Portal ← App Service ← Settings ← Environment variables (Application settings)
# ولّد قيمة عشوائية، مثال:  openssl rand -hex 32
BOT_API_SECRET=
